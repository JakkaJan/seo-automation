# =============================================================================
# SEO AUTOMATION - ENVIRONMENT CONFIGURATION
# =============================================================================
# 
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in ALL values below (replace placeholder values)
# 3. NEVER commit .env to git! (already in .gitignore)
# 4. Place Google service account JSON in secrets/ directory
#
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# ---------------------------------------------------------------------------
# PostgreSQL connection string (default for Docker setup)
DATABASE_URL=postgresql://airflow:airflow@postgres:5432/airflow

# ---------------------------------------------------------------------------
# GOOGLE APIs (Service Account Required)
# ---------------------------------------------------------------------------
# 
# HOW TO GET SERVICE ACCOUNT KEY:
# 1. Go to https://console.cloud.google.com/iam-admin/serviceaccounts
# 2. Create service account: "seo-automation@YOUR_PROJECT.iam.gserviceaccount.com"
# 3. Download JSON key, save as secrets/google-service-account.json
# 4. Grant access in GSC, GA4, and Google Sheets
#
# Path to Google service account JSON key (inside Docker container)
GOOGLE_SERVICE_ACCOUNT_KEY=/opt/airflow/secrets/google-service-account.json

# Google Search Console
# Format: sc-domain:example.com (for domain property)
# Format: https://example.com/ (for URL prefix property)
GSC_SITE_URL=sc-domain:yourdomain.com

# Google Analytics 4
# Property ID is numeric, found in GA4 admin panel
GA4_PROPERTY_ID=123456789

# Google Sheets - Cluster Mapping
# URL of the sheet with columns: URL | Cluster_Name | Category | Subcategory | Priority | Notes
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit

# ---------------------------------------------------------------------------
# YANDEX APIs
# ---------------------------------------------------------------------------
#
# HOW TO GET YANDEX METRIKA TOKEN:
# 1. Go to https://oauth.yandex.ru
# 2. Create app, get token with scope: metrika:read
# 3. Or use direct link: https://oauth.yandex.ru/authorize?response_type=token&client_id=YOUR_CLIENT_ID
#
# HOW TO GET COUNTER ID:
# In Yandex Metrika: Settings → Counter ID (numeric)

YANDEX_METRIKA_TOKEN=your_yandex_metrika_oauth_token_here
YANDEX_METRIKA_COUNTER_ID=12345678

# Yandex Webmaster
# Token from same OAuth app, scope: webmaster:read
YANDEX_WEBMASTER_TOKEN=your_yandex_webmaster_oauth_token_here
# Host ID format: https:yourdomain.com:443
YANDEX_WEBMASTER_HOST_ID=https:yourdomain.com:443

# ---------------------------------------------------------------------------
# TELEGRAM BOT
# ---------------------------------------------------------------------------
#
# HOW TO CREATE BOT:
# 1. Message @BotFather on Telegram
# 2. Send /newbot, name it "SEO Reports Bot"
# 3. Copy the token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
# 4. Start chat with your bot, send /start
# 5. Get chat ID: https://api.telegram.org/bot<TOKEN>/getUpdates

TELEGRAM_BOT_TOKEN=123456789:YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# ---------------------------------------------------------------------------
# EMAIL (SendGrid)
# ---------------------------------------------------------------------------
#
# HOW TO GET SENDGRID API KEY:
# 1. Sign up at https://sendgrid.com
# 2. Create API key with "Mail Send" permissions
# 3. Verify sender email domain

SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
EMAIL_FROM=seo-reports@yourdomain.com
# Comma-separated list
EMAIL_TO=you@yourdomain.com,head-of-marketing@yourdomain.com

# ---------------------------------------------------------------------------
# VISIBILITY WEIGHTS (Adjustable)
# ---------------------------------------------------------------------------
# These weights affect how "visibility score" is calculated from GSC data.
# Higher weight = more impact on score.
# 
# FORMULA: visibility = Σ(impressions × weight(position)) / Σ(impressions × max_weight)
# 
# Adjust these based on your business priorities:
# - Increase top3 weight if top positions are most valuable
# - Decrease other weight if positions >30 don't matter

VISIBILITY_WEIGHT_TOP3=1.0      # Positions 1-3 (highest value)
VISIBILITY_WEIGHT_TOP10=0.5     # Positions 4-10
VISIBILITY_WEIGHT_TOP30=0.2     # Positions 11-30
VISIBILITY_WEIGHT_OTHER=0.0     # Positions >30 (no value)

# ---------------------------------------------------------------------------
# ALERT THRESHOLDS
# ---------------------------------------------------------------------------
# When these thresholds are exceeded, alerts are generated.
# Adjust based on your site's volatility and importance.

ALERT_TRAFFIC_DROP_PCT=20          # Alert if traffic drops >20% week-over-week
ALERT_POSITION_DROP_POINTS=8       # Alert if position drops >8 points
ALERT_POSITION_MIN_IMPRESSIONS=500 # Only for keywords with >500 impressions/month
ALERT_CTR_DROP_PCT=30              # Alert if CTR drops >30%

# ---------------------------------------------------------------------------
# REPORT SETTINGS
# ---------------------------------------------------------------------------
# Customize the look of PDF reports

REPORT_COMPANY_NAME=Your Company Name
# Logo URL (optional, leave empty for no logo)
REPORT_LOGO_URL=
# Primary color for reports (hex format)
REPORT_PRIMARY_COLOR=#2563eb

# ---------------------------------------------------------------------------
# AIRFLOW (Internal)
# ---------------------------------------------------------------------------
# Usually no need to change this
AIRFLOW_UID=50000
